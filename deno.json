{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "auto",
  "name": "@wazoo/wiki",
  "version": "0.1.23",
  "license": "MIT",
  "exports": {
    ".": "./src/wiki/mod.ts",
    "./cli": "./src/wiki/cli.ts"
  },
  "tasks": {
    "check": "deno check src tests parity/run.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-net=127.0.0.1,localhost tests/",
    "parity": "deno run --allow-read --allow-write --allow-run --allow-env parity/run.ts",
    "bake:rules": "deno run --allow-read --allow-write scripts/bake_owl2rl_rules.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint"
  },
  "imports": {
    "@dprint/formatter": "npm:@dprint/formatter@0.5.1",
    "@dprint/json": "npm:@dprint/json@0.21.3",
    "@dprint/markdown": "npm:@dprint/markdown@0.20.0",
    "@dprint/typescript": "npm:@dprint/typescript@0.96.1",
    "@rdfjs/types": "npm:@rdfjs/types@^2.0.1",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/toml": "jsr:@std/toml@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.0",
    "@wazoo/linked-markdown": "jsr:@wazoo/linked-markdown@^0.1.0",
    "@wazoo/sparql-engine": "jsr:@wazoo/sparql-engine@0.4.2",
    "@zazuko/env": "npm:@zazuko/env@^3.0.0",
    "@zazuko/env-node": "npm:@zazuko/env-node@^3.0.0",
    "ajv": "npm:ajv@^8.17.1",
    "dprint-plugin-yaml": "npm:dprint-plugin-yaml@0.5.0",
    "lax-css": "npm:lax-css@0.3.0",
    "lax-markup": "npm:lax-markup@0.3.2",
    "markdown-it": "npm:markdown-it@^14.1.0",
    "jsonld": "npm:jsonld@9.0.0",
    "n3": "npm:n3@^2.0.0",
    "rdf-validate-shacl": "npm:rdf-validate-shacl@0.6.5",
    "rdfjs-inference-engine": "npm:rdfjs-inference-engine@0.2.2",
    "yaml": "npm:yaml@2.9.1"
  },
  "fmt": {
    "include": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "parity/**/*.ts",
      "scripts/**/*.ts",
      "deno.json"
    ],
    "exclude": [
      "docs/",
      "npm/",
      "spike-reasoning/",
      "probes/",
      ".parity-tmp/"
    ]
  },
  "lint": {
    "include": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "parity/**/*.ts",
      "scripts/**/*.ts"
    ],
    "exclude": [
      "docs/",
      "npm/",
      "spike-reasoning/",
      "probes/",
      ".parity-tmp/"
    ]
  },
  "exclude": [
    "docs/",
    "npm/",
    "spike-reasoning/",
    "probes/",
    ".parity-tmp/"
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true
  }
}
