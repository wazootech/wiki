{
  "name": "wazootech-wiki",
  "version": "0.2.2",
  "description": "Clean, pure, idiomatic CLI for managing a semantic LLM wiki",
  "repository": {
    "type": "git",
    "url": "https://github.com/wazootech/wiki.git"
  },
  "homepage": "https://github.com/wazootech/wiki",
  "bugs": {
    "url": "https://github.com/wazootech/wiki/issues"
  },
  "license": "MIT",
  "main": "./dist/runtime.js",
  "module": "./dist/runtime.mjs",
  "types": "./dist/runtime.d.ts",
  "exports": {
    ".": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.js"
    }
  },
  "bin": {
    "wiki": "bin/wiki.js"
  },
  "scripts": {
    "build": "tsup src/runtime.ts --format cjs,esm --dts --out-dir dist --clean --shims --silent",
    "prepack": "npm run build",
    "format": "prettier \"src/*.ts\" --write",
    "format:check": "prettier \"src/*.ts\" --check",
    "lint": "eslint src/*.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:npm": "npm run typecheck && npm run build && node tests/npm/test-runtime.js"
  },
  "files": [
    "bin/",
    "dist/",
    "deno.json",
    "deno.lock",
    "src/wiki/**/*.ts",
    "src/wiki/**/*.html",
    "src/wiki/templates/**/*.yml",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "deno": "2.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.1",
    "eslint": "^9.20.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.5",
    "tsup": "^8.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
