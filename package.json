{
  "name": "wazootech-wiki",
  "version": "0.7.2",
  "description": "Wiki CLI: check, query and publish a folder of Markdown notes",
  "repository": {
    "type": "git",
    "url": "https://github.com/wazootech/wiki.git"
  },
  "homepage": "https://github.com/wazootech/wiki",
  "bugs": {
    "url": "https://github.com/wazootech/wiki/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "bin": {
    "wiki": "bin/wiki.js"
  },
  "scripts": {
    "bench:shacl": "bun bench/shacl/run.ts",
    "build": "bun scripts/build_npm.ts",
    "check": "bun check --no-script",
    "ci": "bun run fmt:check && bun run lint && bun run check && bun run test && bun run publish:dry",
    "fmt": "bun fmt --no-script src/wiki tests bench scripts docs/build.ts package.json jsr.json tsconfig.json .oxlintrc.json",
    "fmt:check": "bun fmt --no-script src/wiki tests bench scripts docs/build.ts package.json jsr.json tsconfig.json .oxlintrc.json --check",
    "lint": "oxlint --deny-warnings",
    "prepack": "bun scripts/build_npm.ts",
    "publish:dry": "jsr publish --dry-run --allow-dirty",
    "test": "bun test --timeout 120000 tests/"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dprint/formatter": "0.5.1",
    "@eslint/markdown": "8.0.3",
    "@zazuko/env": "^3.0.0",
    "@zazuko/env-node": "^3.0.0",
    "ajv": "^8.17.1",
    "bcrypt": "npm:bcryptjs@3.0.3",
    "eslint": "9.39.5",
    "jsonld": "9.0.0",
    "markdown-it": "^14.1.0",
    "n3": "^2.0.0",
    "rdf-validate-shacl": "0.6.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@dprint/json": "0.21.3",
    "@dprint/markdown": "0.20.0",
    "@dprint/typescript": "0.96.1",
    "@rdfjs/types": "^2.0.1",
    "@std/assert": "npm:@jsr/std__assert@^1.0.0",
    "@std/path": "npm:@jsr/std__path@^1.0.0",
    "@std/toml": "npm:@jsr/std__toml@^1.0.0",
    "@std/yaml": "npm:@jsr/std__yaml@^1.0.0",
    "@types/bun": "1.4.5",
    "@types/markdown-it": "^14",
    "@types/n3": "^1.26.6",
    "@types/node": "^24.0.0",
    "@wazoo/linked-markdown": "npm:@jsr/wazoo__linked-markdown@^0.1.0",
    "@wazoo/reasoner": "npm:@jsr/wazoo__reasoner@0.4.2",
    "@wazoo/sparql-engine": "npm:@jsr/wazoo__sparql-engine@0.5.1",
    "dprint-plugin-yaml": "0.5.0",
    "jsr": "0.14.3",
    "lax-css": "0.3.0",
    "lax-markup": "0.3.2",
    "oxlint": "1.95.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
