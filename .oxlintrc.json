{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true
      }
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "_site",
    "probes",
    "spike-reasoning",
    "docs/assets",
    "src/wiki/dprint/*.gen.ts"
  ]
}
